{
  "name": "youtify-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "tsc -p tsconfig.test.json && esbuild src/theme.test.ts --bundle --platform=node --format=esm --outfile=.test/theme.test.js && node --test .test/theme.test.js",
    "tauri": "cd ../crates/tauri-app && tauri"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.4.0",
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "esbuild": "^0.25.12",
    "typescript": "~5.7.3",
    "vite": "^6.0.0"
  }
}
